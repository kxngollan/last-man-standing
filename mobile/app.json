{
  "expo": {
    "name": "Last Man Standing",
    "slug": "last-man-standing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lastmanstanding",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#e05c45",
    "ios": {
      "bundleIdentifier": "com.lastmanstanding.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lastmanstanding.app",
      "adaptiveIcon": {
        "backgroundColor": "#e05c45",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e05c45",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 128,
          "dark": {
            "backgroundColor": "#1c1812"
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Unlock Last Man Standing with Face ID."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Last Man Standing with Face ID."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
