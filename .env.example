# --- Database ---
# MongoDB connection string (e.g. mongodb+srv://user:pass@cluster/last-man-standing)
MONGO_DB_URI=
# Database name within the cluster
MONGO_DB_NAME=

# --- Football data ---
# API key for football-data.org (free tier works; rate-limited ~10 req/min)
FOOTBALL_API=

# Which club badge to show. Club crests are registered trade marks, so this is a
# risk dial rather than a style choice — see lib/crests.ts.
#   pixel     (default) our own pixelated copies from public/crests
#   official  the club's real badge, hotlinked from football-data.org
#   none      no badge; both clients draw the three-letter disc instead
# Read when a team is read, so a change takes effect on the next request. Teams
# hold both badges, so switching back and forth costs nothing and loses nothing.
CREST_STYLE=pixel

# --- Auth (Auth.js v5) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Public base URL, used in email links, the sitemap, canonical URLs and share
# links. No trailing slash. Set it to the real domain in production.
#   e.g. https://www.footballlms.com
APP_URL=http://localhost:3000
# Where Auth.js thinks it lives. Note the /api/auth on the end — this is the
# base of the auth routes, not the site.
#   e.g. https://www.footballlms.com/api/auth
# Leave blank in development. Worth setting in production because the OAuth
# redirect_uri is built from it, and without it Auth.js falls back to the
# request's Host header: a preview deployment or a proxy passing a different
# x-forwarded-host then sends Apple a redirect_uri it has never heard of, and
# Apple answers `invalid_client` with no clue as to why.
AUTH_URL=

# --- Social sign-in (optional; leave blank to hide nothing — the buttons are
# always shown, but a provider without credentials will error on click) ---
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# (Web application). Authorised redirect URI:
#   http://localhost:3000/api/auth/callback/google   (and the same on your domain)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Apple: developer.apple.com → Certificates, Identifiers & Profiles.
# You need a Services ID (that's AUTH_APPLE_ID) and the .p8 signing key below.
# There is no AUTH_APPLE_SECRET: Apple's client secret is a JWT that expires,
# so the app mints one itself, keeps it in the database and renews it before it
# runs out (lib/apple/clientSecret.ts). The three values below are what it
# signs with — the private key is the body of the .p8, with or without its
# -----BEGIN PRIVATE KEY----- lines.
# Return URL: https://your-domain/api/auth/callback/apple
# Apple rejects http:// and localhost, so this can only be tested against an
# HTTPS deployment or a tunnel.
#
# Identifiers → Services IDs. A reverse-DNS string you pick yourself, and NOT
# the app's bundle id — see MOBILE_APPLE_CLIENT_IDS below for that one.
#   e.g. com.footballlms.www
AUTH_APPLE_ID=
# Ten characters, top right of the developer account (Membership details).
#   e.g. M8MAVX34R5
APPLE_TEAM_ID=
# Keys → the Sign in with Apple key you created. Ten characters, and it is also
# in the filename Apple gives you: AuthKey_<APPLE_KEY_ID>.p8
#   e.g. 52Y98XGD62
APPLE_KEY_ID=
# The contents of that .p8 file. Apple lets you download it exactly once.
#   e.g. "MIGTAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBHkwdwIBAQQg...G1ox3zmL"
APPLE_PRIVATE_KEY=

# --- Social sign-in from the mobile app (optional) ---
# The app signs in natively and posts the provider's ID token to
# /api/mobile/auth/social, which checks that the token was issued for one of
# OUR apps. A native sign-in mints the token for the platform's own client ID,
# not the web one, so list every client ID the app may present.
# Comma-separated. AUTH_GOOGLE_ID / AUTH_APPLE_ID are accepted as well.
# Google: the iOS and Android OAuth client IDs from the same Cloud project.
MOBILE_GOOGLE_CLIENT_IDS=
# Apple: the app's BUNDLE ID (native Sign in with Apple puts that in `aud`),
# not the Services ID the web flow uses. It has to match `ios.bundleIdentifier`
# in mobile/app.json exactly, or every sign-in from the app is a 401 — the
# token names the bundle id, and this is the list it's checked against.
#   e.g. com.footballlms
MOBILE_APPLE_CLIENT_IDS=

# --- Email (Nodemailer SMTP) ---
# For local dev, Mailtrap (https://mailtrap.io) is easiest. Leave blank to log links to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Last Man Standing <no-reply@footballlms.com>"

# Where players write for help. Shown on /support, /policy and /delete-account,
# and it is the support contact on both store listings — so it has to be a
# mailbox that exists and is read, including by someone locked out of their
# account. Defaults to support@footballlms.com.
SUPPORT_EMAIL=

# --- Cron ---
# Shared secret required to call /api/cron/resolve (Bearer token).
# On Vercel, the schedule lives in vercel.json and Vercel sends this value as
# `Authorization: Bearer <CRON_SECRET>` by itself — just set the variable in the
# Production environment. Note that Vercel Cron needs Pro for the */15 schedule;
# Hobby only allows once per day.
# Anywhere else, point a scheduler (e.g. cron-job.org) at GET /api/cron/resolve
# every ~15 minutes with header:  Authorization: Bearer <CRON_SECRET>
# Each tick refreshes fixtures, auto-picks for players who missed the
# deadline, and resolves the game week once its fixtures finish.
CRON_SECRET=

# --- Admin (optional) ---
# Comma-separated emails auto-promoted to admin on sign-up. Leave blank to set isAdmin manually in the DB.
ADMIN_EMAILS=
