# --- Database ---
# MongoDB connection string (e.g. mongodb+srv://user:pass@cluster/last-man-standing)
MONGO_DB_URI=
# Database name within the cluster
MONGO_DB_NAME=

# --- Football data ---
# API key for football-data.org (free tier works; rate-limited ~10 req/min)
FOOTBALL_API=

# --- Auth (Auth.js v5) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Public base URL, used in email links. No trailing slash.
APP_URL=http://localhost:3000

# --- Social sign-in (optional; leave blank to hide nothing — the buttons are
# always shown, but a provider without credentials will error on click) ---
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# (Web application). Authorised redirect URI:
#   http://localhost:3000/api/auth/callback/google   (and the same on your domain)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Apple: developer.apple.com → Certificates, Identifiers & Profiles.
# You need a Services ID (that's AUTH_APPLE_ID) and a client secret, which Apple
# requires be a JWT signed with a .p8 key — generate it with `npx auth add apple`.
# It expires after at most 6 months and has to be regenerated.
# Return URL: https://your-domain/api/auth/callback/apple
# Apple rejects http:// and localhost, so this can only be tested against an
# HTTPS deployment or a tunnel.
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# --- Email (Nodemailer SMTP) ---
# For local dev, Mailtrap (https://mailtrap.io) is easiest. Leave blank to log links to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Last Man Standing <no-reply@lastmanstanding.app>"

# --- Cron ---
# Shared secret required to call /api/cron/resolve (Bearer token).
# Point an external scheduler (e.g. cron-job.org) at GET /api/cron/resolve
# every ~15 minutes with header:  Authorization: Bearer <CRON_SECRET>
# Each tick refreshes fixtures, auto-picks for players who missed the
# deadline, and resolves the game week once its fixtures finish.
CRON_SECRET=

# --- Admin (optional) ---
# Comma-separated emails auto-promoted to admin on sign-up. Leave blank to set isAdmin manually in the DB.
ADMIN_EMAILS=
